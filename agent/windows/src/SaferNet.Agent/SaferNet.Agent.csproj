<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SaferNet.Agent</AssemblyName>
    <RootNamespace>SaferNet.Agent</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Packet parsing is internal, but it is the part most worth testing directly. -->
    <InternalsVisibleTo Include="SaferNet.Agent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>
</Project>
